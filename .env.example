# Nebius Token Factory (OpenAI-compatible)
NEBIUS_API_KEY=
TOKENFACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Nebius Token Factory Sandboxes (Contree) — from beta access
CONTREE_BASE_URL=https://api.tokenfactory.nebius.com/sandboxes
NEBIUS_PROJECT_ID=
# Research
TAVILY_API_KEY=
# GitHub (used through `gh`)
GITHUB_TOKEN=
# Model routing — swap without code changes
WARDEN_PLANNER_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
WARDEN_IMPLEMENTER_MODEL=nvidia/nemotron-3-super-120b-a12b
WARDEN_TOOLS_MODEL=nvidia/Nemotron-3_5-Lightning
# Limits
WARDEN_MAX_FORKS=4
WARDEN_MAX_USD_PER_ISSUE=3.0
# Implementer tool turns per issue; below 40 real fixes run out (icalendar#1928 needed 52)
WARDEN_MAX_TOOL_TURNS=60
# Nudge the implementer to edit/run tests after this many turns in a row of only reading (0 = off)
WARDEN_IDLE_NUDGE_AFTER=8
# Answer a re-read of an unchanged file/range the model still has with a short note: 1 | 0
WARDEN_READ_CACHE=1
# Implementer completion budget (max_tokens, reasoning included); 0 = the server default, 8192,
# where Super's whole-file writes were cut. Token Factory serves up to at least 32768 for Super
WARDEN_IMPLEMENTER_MAX_TOKENS=16384
# Best-of-N: implementer candidates per issue, each on its own fork; the verifier picks one (1-8)
WARDEN_CANDIDATES=1
# Theater retries: no new test fails on the unfixed base → the implementer gets that feedback and
# continues from its candidate (<= min(20, max_tool_turns/3) extra turns), then verify reruns (0-3; 0 = off)
WARDEN_THEATER_RETRIES=1
# Verify retry: a valid repro but a red suite / mypy / ruff / regression / unmet spec behaviour →
# the implementer gets those errors and continues once from its candidate (<= 8 extra turns,
# skipped under 20% of the per-issue cap left), then verify reruns (0-1; 0 = off)
WARDEN_VERIFY_RETRIES=1
WARDEN_BASE_IMAGE=warden/fabric-base:latest
# Repo root inside the base image, and the prefix that starts services around run_shell
WARDEN_WORKDIR=/src
# Gate command set for the target repo (warden/verify/gate.py PROFILES): fabric | generic | tests
WARDEN_GATE_PROFILE=fabric
WARDEN_SHELL_WRAP=with-services sh -c
# GitHub repo (owner/name) whose issues Warden plans and fixes
WARDEN_TARGET_REPO=moiz-lakkadkutta/Fabric-Inventory
# Verifier spec review (one Ultra call per issue; a quoted, unimplemented behaviour FAILs): 1 | 0
WARDEN_SPEC_CHECK=1
# The repo's own test command, without file args; set = gate suite + regression check (e.g. python -m pytest -q); required for the `tests` profile
WARDEN_TEST_CMD=
# Branch that fix PRs target for live issues (`warden run --repo` uses the repo's default branch)
WARDEN_BASE_BRANCH=main
# PR body template (markdown; $evidence $disclosure $issue $title $repo $run_id $models); empty = built-in
WARDEN_PR_TEMPLATE=
